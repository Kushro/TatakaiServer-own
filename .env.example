# Optional on Node: missing values are generated once in DATA_DIR/node-secrets.json,
# with a startup warning. Keep that file private and back it up with the database.
# Vercel and Workers require explicit deployment secrets.
# Generate distinct random values; never commit real secrets.
SERVER_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_SECRET=replace-with-another-random-secret
PUBLIC_URL=http://localhost:8787
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
ENABLE_NATIVE_EXTENSIONS=0
ENABLE_BROWSER_RUNTIME=0
# Vercel only:
# DATABASE_URL=postgresql://...
# BLOB_READ_WRITE_TOKEN=...
